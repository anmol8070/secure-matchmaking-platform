{
  "name": "matchmaking-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Secure Social Networking and Digital Matchmaking Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --testPathIgnorePatterns=/tests/integration/",
    "test:db": "jest --runInBand tests/integration",
    "db:create": "node scripts/db-create.js",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:rollback:all": "knex migrate:rollback --all",
    "db:status": "knex migrate:list",
    "db:seed": "knex seed:run",
    "db:reset": "node scripts/db-reset.js",
    "admin:promote": "node scripts/promote-admin.js",
    "smoke:chat": "node scripts/chat-smoke.js",
    "e2e:video": "node scripts/video-call-e2e.js",
    "e2e:video:cleanup": "node scripts/video-call-e2e-cleanup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "puppeteer-core": "^24.43.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
