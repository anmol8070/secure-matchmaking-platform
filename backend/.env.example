# ---------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# Application
NODE_ENV=development
PORT=5000

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Database — DB_CLIENT selects the engine: postgres | mysql
DB_CLIENT=postgres

# Option A: a single connection string (takes precedence when set)
# postgres://user:password@localhost:5432/matchmaking_db
# mysql://user:password@localhost:3306/matchmaking_db
DATABASE_URL=

# Option B: individual settings (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=matchmaking_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_POOL_MIN=0
DB_POOL_MAX=10

# Authentication (used from Phase 3) — use a long random value
JWT_SECRET=replace_with_a_long_random_secret
