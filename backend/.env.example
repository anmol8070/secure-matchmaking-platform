# ---------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# Application
NODE_ENV=development
PORT=5000

# Comma-separated list of frontend origins allowed by CORS.
# "*" allows any origin and is rejected when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173

# Database — DB_CLIENT selects the engine: postgres | mysql (mysql also covers MariaDB)
# Supported: PostgreSQL 12+, MySQL 8.0.16+, MariaDB 10.4+
DB_CLIENT=postgres

# Option A: a single connection string (takes precedence when set)
# postgres://user:password@localhost:5432/matchmaking_db
# mysql://user:password@localhost:3306/matchmaking_db
DATABASE_URL=

# Option B: individual settings (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=matchmaking_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_POOL_MIN=0
DB_POOL_MAX=10

# Database used by `npm run test:db` (all its tables are dropped and rebuilt).
# Defaults to "<DB_DATABASE>_test"; must differ from DB_DATABASE.
DB_TEST_DATABASE=

# Behind a reverse proxy/load balancer set the number of hops (e.g. 1) so rate
# limits see the real client IP. Leave empty when the API is exposed directly.
TRUST_PROXY=

# ---------------- Authentication (Phase 4) ----------------
# Secrets: random values of 32+ characters (required in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# OTP codes (only an HMAC of each code is stored, keyed with OTP_SECRET)
OTP_SECRET=replace_with_a_long_random_secret
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Delivery provider. Options:
#   "dev"        - keeps codes in development outbox (GET /api/v1/dev/otp, never in production)
#   "smtp"       - sends emails via SMTP (requires SMTP_* settings below)
#   "twilio"     - sends SMS via Twilio (requires TWILIO_* settings below)
#   "production" - multi-channel: email via SMTP, mobile via Twilio
OTP_PROVIDER=dev

# SMTP Email Provider Settings (when OTP_PROVIDER is smtp or production)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@your-domain.com
SMTP_SECURE=false

# Twilio SMS Provider Settings (when OTP_PROVIDER is twilio or production)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Live face-presence verification session after credentials/OTP succeed
LOGIN_VERIFICATION_EXPIRY_MINUTES=5
LOGIN_VERIFICATION_MAX_ATTEMPTS=5

# Rate limiting (per window): all /auth requests per IP, and failed
# password/OTP/verification checks per IP + account
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=100
AUTH_FAILED_ATTEMPTS_MAX=10

# Country code added to 10-digit mobile numbers entered without one
DEFAULT_COUNTRY_CODE=+91

# ---------------- Profile pictures (Phase 5) ----------------
# Storage backend: "local" stores files in UPLOADS_DIR and serves them at /media
STORAGE_PROVIDER=local
UPLOADS_DIR=uploads
# Public origin used to build picture URLs (required, https, in production)
MEDIA_PUBLIC_BASE_URL=http://localhost:5000
# Upload size limit and the longest side of the stored (re-encoded) image
PROFILE_IMAGE_MAX_SIZE_MB=5
PROFILE_IMAGE_MAX_DIMENSION=1024

# ---------------- Preferences (Phase 6) ----------------
# Compatibility questionnaire (JSON, validated at startup). The bundled file holds
# SAMPLE questions only — replace it once the real questionnaire is approved.
QUIZ_QUESTIONS_FILE=src/config/quiz-questions.json

# ---------------- Match Recommendations (Phase 8) ----------------
# Default number of candidates returned per page when ?limit is not specified
RECOMMENDATION_DEFAULT_LIMIT=20
# Hard ceiling on the ?limit query parameter (prevents excessively large requests)
RECOMMENDATION_MAX_LIMIT=100

# ---------------- Private chat (Phase 11) ----------------
# Messages per history page when ?limit is not given, and the largest allowed ?limit
MESSAGE_DEFAULT_LIMIT=50
MESSAGE_MAX_LIMIT=100
# Longest message in characters (after trimming)
MESSAGE_MAX_LENGTH=2000
# Messages one user may send per window — REST and Socket.IO share this budget
MESSAGE_RATE_LIMIT=60
MESSAGE_RATE_WINDOW_SECONDS=60

# Optional: Redis for running several API instances (Socket.IO adapter + shared
# message rate limit), e.g. redis://localhost:6379. Leave empty for one instance.
REDIS_URL=

# Images in private chat (stored outside the public /media folder)
CHAT_IMAGE_MAX_SIZE_MB=5
CHAT_IMAGE_MAX_DIMENSION=1600
PRIVATE_UPLOADS_DIR=uploads-private

# ---------------- Video calls (Phase 12) ----------------
# Ringing time before a call becomes "missed", time allowed to connect after
# accepting, and how long a participant may be away (refresh/network) before
# the call ends.
CALL_RING_TIMEOUT_SECONDS=30
CALL_CONNECT_TIMEOUT_SECONDS=45
CALL_REJOIN_GRACE_SECONDS=20
# Signalling messages per user per 10 s, and calls a user may start per minute
CALL_SIGNAL_RATE_LIMIT=300
CALL_INITIATE_RATE_LIMIT=10

# WebRTC ICE servers (comma-separated URLs). STUN alone does not work on every
# network: configure a TURN relay for production.
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
# Preferred: the TURN server's shared secret (coturn "use-auth-secret"); the API
# then issues short-lived per-user credentials. Never put it in the frontend.
WEBRTC_TURN_SECRET=
WEBRTC_TURN_TTL_SECONDS=3600
# Alternative for simple setups: one static TURN username/credential.
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ---------------- Reports (Phase 13) ----------------
# Reports one user may submit per hour
REPORT_RATE_LIMIT_PER_HOUR=10

# ---------------- Admin panel (Phase 14) ----------------
# Admin accounts are never created from config: register normally, then
#   npm run admin:promote -- <email or mobile>
ADMIN_DEFAULT_PAGE_SIZE=20
ADMIN_MAX_PAGE_SIZE=100
# Longest date range for dashboard/activity filters (days)
ADMIN_MAX_RANGE_DAYS=366
# Per-admin limits: API requests per minute, and moderation actions per minute
ADMIN_RATE_LIMIT_PER_MINUTE=300
ADMIN_ACTION_RATE_LIMIT_PER_MINUTE=30
