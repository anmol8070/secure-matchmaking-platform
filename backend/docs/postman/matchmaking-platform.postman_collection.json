{
  "info": {
    "name": "Matchmaking Platform API",
    "description": "Phases 3-5: base API, authentication (registration, OTP, login, live presence verification, JWT, logout) and profile management with profile pictures.\n\nRun the folders in order (they share collection variables). Requires the backend running in development with OTP_PROVIDER=dev,\nbecause OTP codes are read from the development outbox (GET /dev/otp). Command line:\n  npx newman run docs/postman/matchmaking-platform.postman_collection.json --working-dir docs/postman\n\nAuthentication: protected requests send `Authorization: Bearer {{accessToken}}`. The access token is only issued by\nPOST /auth/login-verification/complete, after credentials/OTP AND the live face-presence check succeeded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "allowedOrigin",
      "value": "http://localhost:5173"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Secure123"
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health and errors",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Public. Liveness of the API."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body', () => pm.expect(pm.response.json()).to.include({ success: true, message: 'API is running', version: 'v1' }));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 unknown endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"API endpoint not found\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS blocked origin → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://evil.example.com"
              }
            ],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected module without token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches",
            "description": "Every module except /health, /auth and /admin/login requires a Bearer access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Authentication required\" }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Registration and account OTP",
      "item": [
        {
          "name": "Register — weak password → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"weak@example.com\",\n  \"password\": \"short\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('field error', () => pm.expect(pm.response.json().errors.map(e => e.field)).to.include('body.password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Public. Body: email and/or mobile (+ password: 8–128 chars with a letter and a number). Creates the account as pending_verification and sends an OTP. The OTP is never returned."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `postman${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('otp required, nothing secret returned', () => { pm.expect(d.otp_required).to.eql(true); pm.expect(JSON.stringify(pm.response.json())).to.not.match(/password|hash/i); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — duplicate email → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"An account with these details already exists\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "DEV: read OTP from outbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dev/otp?destination={{email}}",
            "description": "Development only (not mounted in production). Replaces checking your email/SMS."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('otp', pm.response.json().data.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP — wrong code → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('otp') === '000000') pm.request.body.raw = pm.request.body.raw.replace('000000', '111111');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Invalid or expired OTP\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP — valid → account active",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "description": "Public. Body: (email | mobile) + otp. Wrong, expired and unknown codes all return 401 \"Invalid or expired OTP\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('active', () => pm.expect(pm.response.json().data.status).to.eql('active'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP — reuse → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Invalid or expired OTP\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send OTP — generic response",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/send-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\"\n}"
            },
            "description": "Public. Resends an account-verification OTP. Same response whether or not the account exists. Limited by cooldown and hourly cap (429)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.eql(\"If the account exists, an OTP has been sent.\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Login (step 1: credentials)",
      "item": [
        {
          "name": "Login — wrong password → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"Wrong1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Invalid credentials\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — valid → verification challenge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Public. Body: identifier (email or mobile) + password. Returns a temporary verification_token — NOT an access token. The login is completed only by the live verification step."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('live verification required, no access token', () => { pm.expect(d.requires_live_verification).to.eql(true); pm.expect(d.access_token).to.be.undefined; });",
                  "pm.collectionVariables.set('verificationToken', d.verification_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verification token is not an access token → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{verificationToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Live verification (step 2) → JWT",
      "item": [
        {
          "name": "No face → 422 retry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login-verification/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_token\": \"{{verificationToken}}\",\n  \"face_detected\": false,\n  \"face_count\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"No face detected. Please take the photo again.\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Multiple faces → 422 retry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login-verification/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_token\": \"{{verificationToken}}\",\n  \"face_detected\": true,\n  \"face_count\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Multiple faces detected. Please ensure only one person is visible.\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Image in request → 422 (images are never accepted)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login-verification/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_token\": \"{{verificationToken}}\",\n  \"face_detected\": true,\n  \"face_count\": 1,\n  \"image\": \"data:image/jpeg;base64,AAAA\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid verification token → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login-verification/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_token\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\n  \"face_detected\": true,\n  \"face_count\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Invalid or expired verification session. Please log in again.\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "One face → access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login-verification/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_token\": \"{{verificationToken}}\",\n  \"face_detected\": true,\n  \"face_count\": 1,\n  \"confidence\": 0.95,\n  \"detector\": \"postman\"\n}"
            },
            "description": "Public (requires the verification_token from step 1). Body: verification_token, face_detected, face_count (+ optional confidence, detector). Exactly one face passes and returns the JWT access token. Only the detection result is sent — never an image."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('bearer token + safe user', () => { pm.expect(d.token_type).to.eql('Bearer'); pm.expect(d.user.password_hash).to.be.undefined; });",
                  "pm.collectionVariables.set('accessToken', d.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verification token reuse → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login-verification/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_token\": \"{{verificationToken}}\",\n  \"face_detected\": true,\n  \"face_count\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Current user and authorization",
      "item": [
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Requires Authorization: Bearer <access token>. Returns the account without password hash, OTPs or secrets."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('no secrets', () => pm.expect(JSON.stringify(pm.response.json())).to.not.match(/password|hash|otp/i));",
                  "pm.test('active user', () => pm.expect(pm.response.json().data).to.include({ role: 'user', status: 'active' }));"
                ]
              }
            }
          ]
        },
        {
          "name": "User → protected placeholder (501)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/matches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 501', () => pm.response.to.have.status(501));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"This module will be implemented in a later development phase\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "User → admin API → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users",
            "description": "Admin APIs require role=admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"You do not have permission to perform this action\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tampered JWT → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJ1c2VyX2lkIjoxfQ.invalidsignature"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Invalid or expired token\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin login — non-admin → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Public, admin accounts only; same live verification step follows. Promote an account with `npm run admin:promote -- <email>`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Invalid credentials\" }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Profile (Phase 5)",
      "item": [
        {
          "name": "GET /profile before creating → 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "description": "Requires Bearer token. Returns the signed-in user's own profile; 404 until it is created."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Profile not found. Create your profile first.\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /profile — invalid (under 18, missing name) → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateOfBirth\": \"2015-01-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('field errors', () => pm.expect(pm.response.json().errors.map(e => e.field)).to.include.members(['body.name', 'body.dateOfBirth']));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /profile — create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Patil\",\n  \"dateOfBirth\": \"1996-08-15\",\n  \"gender\": \"female\",\n  \"city\": \"Kolhapur\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"education\": \"M.Tech\",\n  \"occupation\": \"Software Developer\",\n  \"lifestyle\": \"Active, vegetarian\",\n  \"bio\": \"Loves trekking.\"\n}"
            },
            "description": "Requires Bearer token. JSON body.\nRequired: name (2-100 chars), dateOfBirth (YYYY-MM-DD, age 18-100).\nOptional (null or \"\" clears): gender (male|female|non_binary|other|prefer_not_to_say), city, state, country, education, occupation, lifestyle, bio (max 2000).\nThe user is taken from the token, never from the body. Returns the profile with computed age, location and profileCompletion. 409 if it already exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('computed age and location', () => { pm.expect(d.age).to.be.a('number'); pm.expect(d.location).to.eql('Kolhapur, Maharashtra, India'); pm.expect(d.profilePhotoUrl).to.eql(null); });",
                  "pm.test('no account/security data', () => pm.expect(JSON.stringify(pm.response.json())).to.not.match(/password|hash|otp|token|role|email/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /profile again → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Patil\",\n  \"dateOfBirth\": \"1996-08-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /profile — update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"occupation\": \"Data Engineer\",\n  \"bio\": null\n}"
            },
            "description": "Requires Bearer token. JSON body with any subset of the profile fields; only provided fields change."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.eql(\"Profile updated successfully\"));",
                  "pm.test('updated', () => pm.expect(pm.response.json().data).to.include({ occupation: 'Data Engineer', bio: null }));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /profile — changing userId/role → 422",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hacker\",\n  \"userId\": 1,\n  \"role\": \"admin\"\n}"
            },
            "description": "Account and security fields (userId, user_id, role, status, password_hash, email, profile_photo_url) are rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /profile/photo — upload (no face needed)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile/photo",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": "assets/landscape-no-face.png"
                }
              ]
            },
            "description": "Requires Bearer token. multipart/form-data with one file in the \"photo\" field.\nJPG, PNG or WEBP up to PROFILE_IMAGE_MAX_SIZE_MB (default 5 MB). Any image is accepted: no face or human detection.\nStored as WEBP (max 1024 px, metadata removed). Replaces the previous picture.\nErrors: 415 unsupported type, 413 too large, 422 missing or corrupt file, 404 no profile yet."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.eql(\"Profile picture updated successfully\"));",
                  "pm.test('photo url', () => pm.expect(pm.response.json().data.profilePhotoUrl).to.include('/media/profile-photos/'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /profile/photo — text renamed to .png → 415",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile/photo",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": "assets/not-an-image.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 415', () => pm.response.to.have.status(415));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Unsupported image type. Use a JPG, PNG or WEBP image.\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('complete', () => pm.expect(pm.response.json().data.profileCompletion.percentage).to.be.above(80));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /profile/photo",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile/photo",
            "description": "Requires Bearer token. Clears the picture; the profile stays."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.eql(\"Profile picture removed\"));",
                  "pm.test('cleared', () => pm.expect(pm.response.json().data.profilePhotoUrl).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /profile without token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Authentication required\" }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Login with OTP",
      "item": [
        {
          "name": "Send login OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login/send-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{email}}\"\n}"
            },
            "description": "Public. Body: identifier. Generic response; active accounts receive a login OTP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.eql(\"If the account exists, an OTP has been sent.\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "DEV: read login OTP",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dev/otp?destination={{email}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('login purpose', () => pm.expect(pm.response.json().data.purpose).to.eql('login'));",
                  "pm.collectionVariables.set('otp', pm.response.json().data.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify login OTP → verification challenge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "description": "Public. Body: identifier + otp. Like password login, returns a verification_token; live verification is still required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('no access token yet', () => pm.expect(pm.response.json().data.access_token).to.be.undefined);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. Logout",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Requires Bearer token. Revokes this session server-side; the token stops working immediately."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.eql(\"Logged out successfully\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token after logout → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Session has expired or been revoked. Please log in again.\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout without token → 401",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body', () => pm.expect(pm.response.json()).to.include({ success: false, message: \"Authentication required\" }));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
