{
  "info": {
    "name": "Matchmaking Platform API",
    "description": "Phase 3 — base REST API. Run with Postman or: npx newman run matchmaking-platform.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "allowedOrigin",
      "value": "http://localhost:5173"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success, message, version', () => pm.expect(body).to.include({ success: true, message: 'API is running', version: 'v1' }));",
                  "pm.test('timestamp is ISO date', () => pm.expect(Date.parse(body.timestamp)).to.not.be.NaN);",
                  "pm.test('no sensitive fields', () => pm.expect(Object.keys(body)).to.have.members(['success','message','version','timestamp','environment']));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors and middleware",
      "item": [
        {
          "name": "404 unknown endpoint",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('standard 404 body', () => pm.expect(pm.response.json()).to.eql({ success: false, message: 'API endpoint not found' }));"
                ]
              }
            }
          ]
        },
        {
          "name": "422 invalid path parameter",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/profile/abc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.test('validation body', () => { pm.expect(body.success).to.eql(false); pm.expect(body.message).to.eql('Validation failed'); pm.expect(body.errors[0].field).to.eql('params.userId'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "400 malformed JSON",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"bad json\""
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('safe message', () => pm.expect(pm.response.json()).to.eql({ success: false, message: 'Malformed JSON in request body' }));"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS allowed origin",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": [
              {
                "key": "Origin",
                "value": "{{allowedOrigin}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('origin echoed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.variables.get('allowedOrigin')));"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS blocked origin",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": [
              {
                "key": "Origin",
                "value": "http://evil.example.com"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('no CORS header', () => pm.expect(pm.response.headers.has('Access-Control-Allow-Origin')).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
