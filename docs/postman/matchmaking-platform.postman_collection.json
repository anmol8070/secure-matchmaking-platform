{
  "info": {
    "name": "Matchmaking Platform API",
    "description": "Phase 1 — project setup endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('API is running', () => {",
              "  pm.expect(pm.response.json()).to.eql({ success: true, message: 'API is running' });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown route (404 error format)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/does-not-exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('error body', () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ]
    }
  ]
}
