# Copy to .env. Only VITE_-prefixed variables are exposed to the browser —
# never put secrets or database credentials here.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional: self-host the MediaPipe face-detection runtime/model instead of the
# public CDNs used by default (see src/services/faceDetectionService.js).
# VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm
# VITE_FACE_DETECTOR_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/1/blaze_face_short_range.tflite
